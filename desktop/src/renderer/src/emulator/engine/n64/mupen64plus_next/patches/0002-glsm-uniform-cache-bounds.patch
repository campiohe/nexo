Nexo's fix to libretro-common's GL state manager in Mupen64Plus-Next (libretro/mupen64plus-libretro-nx @
15bada85906593376e8fd697f1b0b3af3a20f512), which GLideN64 makes all its GL calls through in libretro builds.

- glsm.c: its uniform cache, program_uniforms[1024][1024], is indexed by program name and uniform location
  without bounds checks. Native drivers keep program names small; WebGL in Emscripten names every GL object
  (textures, buffers, shaders, programs) from one counter, so after about a thousand objects each new shader
  program's name is past the end: rglCreateProgram zeroed 80 KB of whatever lay ~80 KB × name past the array,
  and its uniform updates wrote there too. That was the N64's RDRAM: Mario Kart 64's display list was wiped
  mid-frame as a race started (the graphics plugin then read garbage: a freeze, or "memory access out of bounds"),
  and other writes corrupted game threads. Out of range now means uncached (GLideN64 caches uniform values
  itself). Not WebAssembly-specific, so not under NEXO_REENTRANT.

diff --git i/libretro-common/glsm/glsm.c w/libretro-common/glsm/glsm.c
index b3e8c60..f16a494 100644
--- i/libretro-common/glsm/glsm.c
+++ w/libretro-common/glsm/glsm.c
@@ -268,6 +268,17 @@ static struct gl_cached_state gl_state;
 
 static bool copy_image_support = 0;
 static struct gl_program_uniforms program_uniforms[MAX_UNIFORMS][MAX_UNIFORMS];
+
+/* Nexo: the cache above is indexed by program name and uniform location, which weren't bounds-checked. WebGL
+ * (Emscripten) names all GL objects from one counter, so programs soon get names past MAX_UNIFORMS, and creating
+ * or setting uniforms of one wrote over unrelated memory (Mario Kart 64's display lists at the start of a race).
+ * Out of range: no caching (GLideN64 caches uniform values itself anyway). */
+static struct gl_program_uniforms *glsm_uniform_slot(GLuint program, GLint location)
+{
+   if (program >= MAX_UNIFORMS || location < 0 || location >= MAX_UNIFORMS)
+      return NULL;
+   return &program_uniforms[program][location];
+}
 static struct gl_framebuffers* framebuffers[MAX_FRAMEBUFFERS];
 
 static GLenum active_texture;
@@ -1666,9 +1677,8 @@ GLuint rglCreateProgram(void)
    log_cb(RETRO_LOG_INFO, "glCreateProgram.\n");
 #endif
    GLuint temp = glCreateProgram();
-   int i;
-   for (i = 0; i < MAX_UNIFORMS; ++i)
-      memset(&program_uniforms[temp][i], 0, sizeof(struct gl_program_uniforms));
+   if (temp < MAX_UNIFORMS)
+      memset(program_uniforms[temp], 0, sizeof(program_uniforms[temp]));
    return temp;
 }
 
@@ -1965,9 +1975,10 @@ void rglUniform1f(GLint location, GLfloat v0)
 #ifdef GLSM_DEBUG
    log_cb(RETRO_LOG_INFO, "glUniform1f.\n");
 #endif
-   if (program_uniforms[gl_state.program][location].uniform1f != v0) {
+   struct gl_program_uniforms *u = glsm_uniform_slot(gl_state.program, location);
+   if (!u || u->uniform1f != v0) {
       glUniform1f(location, v0);
-      program_uniforms[gl_state.program][location].uniform1f = v0;
+      if (u) u->uniform1f = v0;
    }
 }
 
@@ -1982,9 +1993,10 @@ void rglUniform1fv(GLint location,  GLsizei count,  const GLfloat *value)
 #ifdef GLSM_DEBUG
    log_cb(RETRO_LOG_INFO, "glUniform1fv.\n");
