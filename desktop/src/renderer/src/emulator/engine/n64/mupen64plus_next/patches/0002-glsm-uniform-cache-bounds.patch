+   struct gl_program_uniforms *u = glsm_uniform_slot(gl_state.program, location);
+   if (!u || u->uniform1f != value[0]) {
       glUniform1fv(location, count, value);
-      program_uniforms[gl_state.program][location].uniform1f = value[0];
+      if (u) u->uniform1f = value[0];
    }
 }
 
