# Copy to .env and fill in:  cp .env.example .env
# Generate a secret with:    openssl rand -hex 32

# ---- Nexo server ----
PORT=3001
SERVER_NAME=Nexo
# Optional: friends must type this the first time they join. Leave empty for no password.
SERVER_PASSWORD=
# Where the SQLite database lives (relative to server/)
DATA_DIR=./data

# ---- LiveKit (voice / video / screen share) ----
# Must match the key in LIVEKIT_KEYS below. Secret must be at least 32 characters.
LIVEKIT_API_KEY=nexo
LIVEKIT_API_SECRET=change-me-to-a-long-random-string-0123456789
# Used by docker-compose for the LiveKit container: exactly "key: secret" (with the space).
LIVEKIT_KEYS=nexo: change-me-to-a-long-random-string-0123456789
# URL that *clients* use to reach LiveKit. Leave empty to derive it from the host
# clients used to reach this server (e.g. http://100.101.102.103:3001 -> ws://100.101.102.103:7880).
LIVEKIT_PUBLIC_URL=
# IP LiveKit advertises to clients for media (ICE). Set it to this machine's Tailscale IP
# (`tailscale ip -4`, a 100.x address) so friends' voice/video connects. Empty = auto-detect
# (inside WSL that picks an unreachable 10.255.255.254). scripts/urls.sh tells you what to use.
# Restart LiveKit after changing it: npm run media
LIVEKIT_NODE_IP=
